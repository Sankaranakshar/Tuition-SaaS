{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && npm run build:api",
  "outputDirectory": "dist",
  "framework": null,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/materialize-sessions", "schedule": "0 20 * * *" },
    { "path": "/api/cron/reporting-daily", "schedule": "5 20 * * *" },
    { "path": "/api/cron/reconcile-wallets", "schedule": "10 20 * * *" },
    { "path": "/api/cron/expire-credits", "schedule": "15 20 * * *" }
  ]
}
